{
  "name": "vintasend-aws-s3-attachments",
  "version": "1.0.0-alpha7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vintasoftware/vintasend-ts-aws-s3-attachments.git"
  },
  "description": "Implementation of AWS S3 Attachments for VintaSend",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
