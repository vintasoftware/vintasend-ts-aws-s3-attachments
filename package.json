    "vintasend": "^1.0.0-alpha7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
